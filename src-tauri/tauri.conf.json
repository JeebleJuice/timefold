{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Timefold",
  "version": "0.1.0",
  "identifier": "dev.jeeblejuice.timefold",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Timefold",
      "width": 1440,
      "height": 880,
      "minWidth": 1000,
      "minHeight": 680,
      "resizable": true
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Explore how a Git repository changed over time"
  }
}
